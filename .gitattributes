# Normalise line endings so the repository behaves the same on every machine.
# Text is stored with LF in the repository; Windows checkouts get CRLF.
* text=auto eol=lf

# Explicit text types
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.ps1     text eol=lf
*.gitignore text eol=lf

# Binary assets must never be converted
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.wav     binary
*.ogg     binary
*.mp3     binary
*.ttf     binary
*.otf     binary
*.zip     binary
*.whl     binary
